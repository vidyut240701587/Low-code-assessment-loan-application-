	reports
	{
		list opportunity_matches_Report
		{
			displayName = "All Opportunity Matches"
			show all rows from opportunity_matches    
			(
				student as "Student"
				opportunity as "Opportunity"
				match_percentage as "Match Percentage"
				matching_skills as "Matching Skills"
				missing_skills as "Missing Skills"
				last_calculated as "Last Calculated"
			)
		}
		list applications_Report
		{
			displayName = "All Applications"
			show all rows from applications    
			(
				student as "Student"
				opportunity as "Opportunity"
				application_date as "Application Date"
				match_percentage as "Match Percentage"
				missing_skills as "Missing Skills"
				application_status as "Application Status"
				remarks as "Remarks"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (application_status == "Applied")
				fields = [application_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (application_status == "Interview")
				fields = [application_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (application_status == "Selected")
				fields = [application_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban applications_by_application_status
		{
			displayName = "Application Statuses"
			show all rows from applications    
			(
				student as "Student"
				opportunity as "Opportunity"
				application_date as "Application Date"
				match_percentage as "Match Percentage"
				missing_skills as "Missing Skills"
				application_status as "Application Status"
				remarks as "Remarks"
			)
			options
			(
	 			display field = application_status
	 		)
		}
		list skill_development_Report
		{
			displayName = "All Skill Developments"
			show all rows from skill_development    
			(
				student as "Student"
				skill_to_learn as "Skill To Learn"
				related_opportunity as "Related Opportunity"
				priority as "Priority"
				learning_status as "Learning Status"
				target_completion_date as "Target Completion Date"
				notes as "Notes"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (priority == "High")
				fields = [priority]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (priority == "Low")
				fields = [priority]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (priority == "Medium")
				fields = [priority]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban skill_development_by_priority
		{
			displayName = "Priorities"
			show all rows from skill_development    
			(
				student as "Student"
				skill_to_learn as "Skill To Learn"
				related_opportunity as "Related Opportunity"
				priority as "Priority"
				learning_status as "Learning Status"
				target_completion_date as "Target Completion Date"
				notes as "Notes"
			)
			options
			(
	 			display field = priority
	 		)
		}
		list opportunities_Report
		{
			displayName = "All Opportunities"
			show all rows from opportunities    
			(
				opportunity_id as "Opportunity ID"
				opportunity_title as "Opportunity Title"
				organization_name as "Organization Name"
				opportunity_type as "Opportunity Type"
				description as "Description"
				required_skills as "Required Skills"
				minimum_cgpa as "Minimum CGPA"
				eligibility_criteria as "Eligibility Criteria"
				application_deadline as "Application Deadline"
				application_link as "Application Link"
				opportunity_status as "Opportunity Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (opportunity_type == "Certification")
				fields = [opportunity_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (opportunity_type == "Hackathon")
				fields = [opportunity_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (opportunity_type == "Internship")
				fields = [opportunity_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (opportunity_type == "Job")
				fields = [opportunity_type]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban opportunities_by_opportunity_type
		{
			displayName = "Opportunity Types"
			show all rows from opportunities    
			(
				opportunity_id as "Opportunity ID"
				opportunity_title as "Opportunity Title"
				organization_name as "Organization Name"
				opportunity_type as "Opportunity Type"
				description as "Description"
				required_skills as "Required Skills"
				minimum_cgpa as "Minimum CGPA"
				eligibility_criteria as "Eligibility Criteria"
				application_deadline as "Application Deadline"
				application_link as "Application Link"
				opportunity_status as "Opportunity Status"
			)
			options
			(
	 			display field = opportunity_type
	 		)
		}
		list student_certificates_Report
		{
			displayName = "All Student Certificates"
			show all rows from student_certificates    
			(
				student as "Student"
				certificate_name as "Certificate Name"
				issuing_organization as "Issuing Organization"
				completion_date as "Completion Date"
				certificate_document as "Certificate Document"
				extracted_text as "Extracted Text"
				verification_status as "Verification Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (verification_status == "Pending Review")
				fields = [verification_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (verification_status == "Rejected")
				fields = [verification_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (verification_status == "Verified")
				fields = [verification_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban student_certificates_by_verification_status
		{
			displayName = "Verification Statuses"
			show all rows from student_certificates    
			(
				student as "Student"
				certificate_name as "Certificate Name"
				issuing_organization as "Issuing Organization"
				completion_date as "Completion Date"
				certificate_document as "Certificate Document"
				extracted_text as "Extracted Text"
				verification_status as "Verification Status"
			)
			options
			(
	 			display field = verification_status
	 		)
		}
		list student_profile_Report
		{
			displayName = "All Student Profiles"
			show all rows from student_profile    
			(
				student_id as "Student ID"
				full_name as "Full Name"
				college_email as "College Email"
				phone_number as "Phone Number"
				department as "Department"
				year_of_study as "Year of Study"
				cgpa as "CGPA"
				technical_skills as "Technical Skills"
				certifications_summary as "Certifications Summary"
				projects_summary as "Projects Summary"
				career_goal as "Career Goal"
				profile_status as "Profile Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (year_of_study == "Final Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (year_of_study == "First Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (year_of_study == "Second Year")
				fields = [year_of_study]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (year_of_study == "Third Year")
				fields = [year_of_study]
				format = "color:#000000;background-color:#398ef3;"
				}
			)
		}
		kanban student_profile_by_department
		{
			displayName = "Departments"
			show all rows from student_profile    
			(
				student_id as "Student ID"
				full_name as "Full Name"
				college_email as "College Email"
				phone_number as "Phone Number"
				department as "Department"
				year_of_study as "Year of Study"
				cgpa as "CGPA"
