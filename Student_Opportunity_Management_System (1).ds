 application "Student Opportunity Management System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form applications
		{
			displayname = "Applications"
			success message = "Applications Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			student
			(
				type = picklist	
				displayname = "Student"
				values  = student_profile.ID
    			displayformat = [student_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			opportunity
			(
				type = picklist	
				displayname = "Opportunity"
				values  = opportunities.ID
    			displayformat = [opportunity_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_date
			(
    			type = date
				displayname = "Application Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			match_percentage
			(
				type = number
				displayname = "Match Percentage"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			missing_skills
			(
    			type = textarea
				displayname = "Missing Skills"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			application_status
			(
				type = picklist
				displayname = "Application Status"
				values = {"Shortlisted","Selected","Rejected","Applied","Interview"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			remarks
			(
    			type = textarea
				displayname = "Remarks"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form opportunities
		{
