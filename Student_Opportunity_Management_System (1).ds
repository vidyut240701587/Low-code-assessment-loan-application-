		workflow
		{
		form
		{
			auto_set_profile_status as "Auto-Set Profile Status"
			{
				type =  form
				form = student_profile

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Check if this is a new record creation (Added_Time is set, Modified_Time is not yet different from Added_Time)
										if(input.ID == null || input.ID == 0)
										{
											// Set profile_status to Active for new student registration
											input.profile_status = "Active";
										}
						)
					}
				}

			}
			validate_cgpa_requirement as "Validate CGPA Requirement"
			{
				type =  form
				form = applications

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the opportunity record based on the lookup field
										opportunityRecord = opportunities[ID == input.opportunity];
										// Get the minimum CGPA requirement from the opportunity
										minimumCGPA = opportunityRecord.minimum_cgpa;
										// Get the student's CGPA from the input
										studentCGPA = input.student.cgpa;
										// Check if the student's CGPA is below the opportunity's minimum requirement
										if(studentCGPA < minimumCGPA)
										{
											// Display an alert message to the user
											alert(opportunity,"Student CGPA is below the minimum requirement for this opportunity.");
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			email_notification as "email notification"
			{
				type =  form
				form = student_profile

				record event = on add

				on success
				{
					actions 
					{
						sendmail
						(
							from : "vidyutrao.s.2024.cse@rajalakshmi.edu.in"
							to : college_email
							subject : "Record Added"
							message : "<div>${zoho.loginuserid}&nbsp;<br></div><p><span>Hello,</span><br></p><p><span>Your student profile has been successfully created in CAMPUS360 – Smart Student Opportunity &amp; Skill-Gap Management System.</span><br></p><p><span>You can now manage your skills, certifications, projects, and career opportunities through the platform.</span><br></p><p></p><div><span>Thank you,</span><br></div><div><span>CAMPUS360 Team</span><br></div><p></p><div><br></div>"
						)
					}
				}

			}
			ocr as "ocr"
			{
				type =  form
				form = student_certificates

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											if(input.certificate_document != null)
										{
											ocrResponse = zoho.ai.recognizeText(input.certificate_document,"OCR","eng");
											info ocrResponse;
										}
						)
					}
				}

			}
		}

		schedule
		{
			opportunity_status_cleanup as "Opportunity Status Cleanup"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all opportunities where the application deadline has passed and status is not already Closed
										closedOpportunities = opportunities[application_deadline < today && opportunity_status != "Closed"];
										// Iterate through each opportunity and update its status to Closed
										for each  opportunity in closedOpportunities
										{
											opportunity.opportunity_status="Closed";
										}
										// Send notification email to admin about closed opportunities
										if(closedOpportunities.count() > 0)
										{
											subject = "Opportunities Closed Automatically";
											message = "The following opportunities have been closed automatically after their application deadline passed:";
											for each  opportunity in closedOpportunities
											{
												message = message.concat("\n- ").concat(opportunity.opportunity_title);
											}
											sendmail
											[
												from :zoho.adminuserid
												to :zoho.adminuserid
												subject :subject
												message :message
											]
										}
					)
					}
				}
			}
		}




