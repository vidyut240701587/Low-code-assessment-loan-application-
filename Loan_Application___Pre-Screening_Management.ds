			)
			options
			(
	 			display field = Loan_Type
	 		)
		}
		calendar Callback_Schedule_Calendar
		{
			displayName = "Callback_Schedule_Calendar"
			show all rows from Loan_Application_Form    
			(
				Applicant_Name 
				Date_Of_Birth
				PAN_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Employment_Type
				Monthly_Income
				Existing_Liabilities
				Loan_Type
				Preferred_Callback_Time
				Purpose_Of_Loan
				Consent_For_Credit_CheckCaptures
				Applicant_Photo
				branvchess
				Income_Proof_Upload
