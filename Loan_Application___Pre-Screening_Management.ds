 * Version      : 1.0
 */
 application "Loan Application & Pre-Screening Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form branvchess
		{
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			branch_name
			(
    			type = textarea
				displayname = "branch name"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Loan_Application_Form
		{
			success message = "Data Added Successfully!"
			Section1
			(
				type = section
				displayname = "Personal Details"
				visibility = true
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Applicant_Name
			(
    			type = name
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Date_Of_Birth
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			PAN_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Section_B
			(
				type = section
				displayname = "Contact Details"
				visibility = true
	 			row = 2
	 			column = 0   
				width = medium
			)
			Email_Address
			(
    			type = email
				maxchar = 80
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Contact_Number
			(
    			type = phonenumber
    			allowedcountries={in}
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 2
	 			column = 1   
				width = medium
				personal data = true
			)
			Section_C
			(
				type = section
				displayname = "Income & Employment Details"
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			must have Employment_Type
			(
				type = radiobuttons
				maxchar = 100
				values = {"salaried","daily wages","self emloyeed"}
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Monthly_Income
			(
				type = number
				initial value = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			Existing_Liabilities
			(
				type = list	
				values = {"car loan","edu loan","Choice 3"}
				height = 60px
	 			row = 3
	 			column = 1   
				width = medium
			)
			Section_D
			(
				type = section
				displayname = "Loan Details & Consent"
				visibility = true
	 			row = 4
	 			column = 0   
				width = medium
			)
			must have Loan_Type
			(
				type = picklist
				maxchar = 100
				values = {"home loan","edu loan","bike loan","car loan"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Preferred_Callback_Time
			(
    			type = time
				timedisplayoptions = "hh:mm:ss" 
	 			row = 4
	 			column = 1   
				width = medium
			)
			Purpose_Of_Loan
			(
    			type = textarea
				height = 100px
	 			row = 4
	 			column = 1   
				width = medium
			)
			must have Consent_For_Credit_CheckCaptures
			(
				type = checkboxes	
				values = {"I consent to a credit bureau check","Choice 2","Choice 3"}
	 			row = 4
	 			column = 1   
				width = medium
			)
			Section2
			(
				type = section
				displayname = "Branch Verification & KYC"
				visibility = true
	 			row = 5
	 			column = 0   
				width = medium
			)
			Applicant_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 5
	 			column = 1   
				width = medium
			)
			branvchess
			(
				type = picklist	
				values  = branvchess.ID
    			displayformat = [ID]
				sortorder = ascending
	 			row = 5
	 			column = 1   
				width = medium
			)
			Income_Proof_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 5
	 			column = 1   
				width = medium
			)
			Debt_To_Income_Ratio
			(
				type = decimal
	 			row = 5
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 6
	 			column = 0   
				width = medium
			)
			Property_Listing_URL
			(
    			type = url
				enable  linkname
	 			row = 6
	 			column = 1   
				width = medium
			)
			Property_Video_Walkthrough
			(
    			type = video
    			duration=30
	 			row = 6
	 			column = 1   
				width = medium
			)
			Loan_Purpose_Voice_Note
			(
     			type = audio
    			duration=60
	 			row = 6
	 			column = 1   
				width = medium
			)
			SubForm
			(
				type = grid
				co_applicant_name
				(
    				type = name
					displayname = "co-applicant name"
     				prefix
     				(
	     				 type = prefix
	     				 displayname ="Prefix"
	     				 visibility = false
	     				 value = {"Mr.","Mrs.","Ms."}
     				) 
     				first_name
     				(
	     				 type = first_name
	     				 displayname ="First Name"
     				) 
     				last_name
     				(
	     				 type = last_name
	     				 displayname ="Last Name"
     				) 
     				suffix
     				(
	     				 type = suffix
	     				 displayname ="Suffix"
	     				 visibility = false
     				) 
					width = medium
					personal data = true
				)
				Single_Line
				(
    				type = text
					displayname = "Single Line"
					width = medium
				)
				salary
				(
					type = INR
					format = commadotindian
					width = medium
				)
	 			row = 7
	 			column = 1   
				width = medium
			)
			Section4
			(
				type = section
				displayname = "— Loan Terms & EMI Computation"
				visibility = true
	 			row = 8
	 			column = 0   
				width = medium
			)
			Has_Existing_Loan_With_Bank
			(
    			type = checkbox
				initial value = false
	 			row = 8
	 			column = 1   
				width = medium
			)
			Loan_Amount_Requested
			(
				type = INR
				format = commadotindian
	 			row = 8
	 			column = 1   
				width = medium
			)
			Standard_Tenure_Month
			(
				type = number
				displayname = "Standard_Tenure_Month "
	 			row = 8
	 			column = 1   
				width = medium
			)
			Interest_Rate_Offered
			(
    			type = percentage
				initial value = 1%
	 			row = 8
	 			column = 1   
				width = medium
			)
			Formula
			(
				type = decimal
	 			row = 8
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  (input.Loan_Amount_Requested * input.Interest_Rate_Offered) / (12 * input.Standard_Tenure_Month)
    						visibility = true
    			)
			)
			Declaration_System_Generated_Values
			(
				type = section
				displayname = "Declaration & System-Generated Values"
				visibility = true
	 			row = 9
	 			column = 0   
				width = medium
			)
			Loan_Terms_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
	 			row = 9
	 			column = 1   
				width = medium
			)
			Applicant_Digital_Signature
			(
    			type = signature
	 			row = 9
	 			column = 1   
				width = medium
				personal data = true
			)
			Application_Submitted_On
			(
    			type = datetime
				initial value = "${zoho.currentdate}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 9
	 			column = 1   
				width = medium
			)
			Loan_Application_ID
			(
    			type = autonumber
				start index = 1
	 			row = 9
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "QR Code"
				value = "${Loan_Application_ID}"
	 			row = 9
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Loan_Application_Form_Report
		{
			displayName = "Loan_Application_Form Report"
			show all rows from Loan_Application_Form    
			(
				Applicant_Name 
				Date_Of_Birth
				PAN_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Employment_Type
				Monthly_Income
				Existing_Liabilities
				Loan_Type
				Preferred_Callback_Time
				Purpose_Of_Loan
				Consent_For_Credit_CheckCaptures
				Applicant_Photo
				Income_Proof_Upload
				Debt_To_Income_Ratio
				SubForm.co_applicant_name as "SubForm"
				Property_Listing_URL
				Property_Video_Walkthrough
				Loan_Purpose_Voice_Note
				Has_Existing_Loan_With_Bank
				Loan_Amount_Requested
				Interest_Rate_Offered
				Loan_Terms_Display
				Applicant_Digital_Signature
				Application_Submitted_On
				Loan_Application_ID
				QR_Code as "QR Code"
				branvchess
				Standard_Tenure_Month as "Standard_Tenure_Month "
				Formula
			)
		}
		default list branvchess_Report
		{
			displayName = "branvchess Report"
			show all rows from branvchess    
			(
				branch_name as "branch name"
			)
		}
		list All_Loan_Applications_List_List_View
		{
			displayName = "All_Loan_Applications_List (List View)"
			show all rows from Loan_Application_Form    
