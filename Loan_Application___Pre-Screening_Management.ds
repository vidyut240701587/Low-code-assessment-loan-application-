		kanban Loan_Status_Kanban
		{
			displayName = "Loan_Status_Kanban"
			show all rows from Loan_Application_Form    
			(
				Applicant_Name 
				Date_Of_Birth
				PAN_Number
				Email_Address
				Contact_Number
				(
					displayformat = plainnumber 
				)
				Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Employment_Type
				Monthly_Income
