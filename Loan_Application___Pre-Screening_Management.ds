				Loan_Type
				Preferred_Callback_Time
				Purpose_Of_Loan
				Consent_For_Credit_CheckCaptures
				Applicant_Photo
				branvchess
				Income_Proof_Upload
				Debt_To_Income_Ratio
				Property_Listing_URL
				Property_Video_Walkthrough
				Loan_Purpose_Voice_Note
				Has_Existing_Loan_With_Bank
				Loan_Amount_Requested
				Standard_Tenure_Month as "Standard_Tenure_Month "
				Interest_Rate_Offered
				Formula
				Loan_Terms_Display
				Applicant_Digital_Signature
				Application_Submitted_On
				Loan_Application_ID
				QR_Code as "QR Code"
			)
		}
