		workflow
		{
		form
		{
			Send_Email_Form_Propertie as "Send Email - Form Properties"
			{
				type =  presuccess
				form = Loan_Application_Form
				on start
				{
					actions 
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Email_Address
							subject : "Loan Application & Pre-Screening Management : New entry added"
							message : "<div>Hello,<br><br>your entry added in 'Loan_Application_Form' form of Loan Application & Pre-Screening Management application.<br></div>"
						)
					}
				}
			}
			age as "age"
			{
				type =  form
				form = Loan_Application_Form

				record event = on add

				field rules
				{
					actions  (Date_Of_Birth > '24-Jul-2008')
					{
					Date_Of_Birth="24-Jul-2026";
					}
				}

			}
		}






